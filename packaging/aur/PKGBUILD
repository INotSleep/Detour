pkgname=detour-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Open-source SSH client with end-to-end encrypted sync and teams"
arch=('x86_64')
url="https://github.com/INotSleep/Detour"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme')
provides=('detour')
conflicts=('detour')
options=('!strip' '!debug')
source_x86_64=("https://github.com/INotSleep/Detour/releases/download/v${pkgver}/Detour_${pkgver}_amd64.deb")
sha256sums_x86_64=('d63c376a1e3ef3803b85b1d0fa040728426fd7a25e80e72465b14716be8c1af4')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  chmod 755 "$pkgdir"/usr/bin/detour "$pkgdir"/usr/bin/detour-desktop
}
