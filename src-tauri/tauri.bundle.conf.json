{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/sidecar.mjs"
  },
  "bundle": {
    "externalBin": ["binaries/detour"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/cli-path.wxs"],
        "componentRefs": ["DetourCliPath"]
      }
    }
  }
}
