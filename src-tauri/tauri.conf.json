{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Detour",
  "version": "0.2.0",
  "identifier": "dev.detour.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Detour",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NTg4NzU5Njk2RDBCODMKUldTREMyMXBXWWRZZGdYWUsrakJEbnEwOFVtZ0FSTVdRaWsxN3FFTUE1RTYxeGlBQVhZbDZRMEYK",
      "endpoints": [
        "https://github.com/INotSleep/Detour/releases/latest/download/latest.json"
      ]
    }
  }
}
